<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gesture recognition for the motion controls. Pure C#: System.Numerics only, no Unity, no game types, no
       BepInEx, so it builds and is tested on any machine (see .github/workflows/gestures.yml). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NIVR.Gestures</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
